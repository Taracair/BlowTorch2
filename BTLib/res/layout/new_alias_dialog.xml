<?xml version="1.0" encoding="UTF-8"?>

<!-- Opaque full-screen Family A shell. Short form is fine: empty space sits
     under the fields, Cancel/?/Done stay on the footer bar. Pair with
     EditorDialogChrome.fullScreenTheme + applyFullScreen. -->
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/newaliaslayout"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@color/chrome_body"
  android:orientation="vertical">

  <TextView
		android:id="@+id/titlebar"
		style="@style/BlowTorch.Chrome.Title"
		android:text="ALIAS EDITOR"/>

  <ScrollView
  	android:id="@+id/alias_editor_scroll"
  	android:layout_width="match_parent"
  	android:layout_height="0dip"
  	android:layout_weight="1"
  	android:fillViewport="true">
  	<LinearLayout
  		android:layout_width="match_parent"
  		android:layout_height="wrap_content"
  		android:orientation="vertical"
  		android:paddingLeft="8dip"
  		android:paddingRight="8dip"
  		android:paddingBottom="8dip">
  <TableLayout
  	android:layout_width="match_parent"
  	android:layout_height="wrap_content"
  	android:stretchColumns="1"
  	android:shrinkColumns="1"
  	android:id="@+id/alias_label">

  	<TableRow>
  		<TextView
  			android:layout_width="wrap_content"
  			android:layout_height="wrap_content"
 			android:text = "Replace:"
 			android:gravity="right"
 			android:layout_marginRight="5dip"/>
  		<EditText
  			android:id = "@+id/new_alias_pre"
  			android:layout_width="0dip"
  			android:layout_weight="1"
  			android:singleLine = "true"
  			android:layout_height="wrap_content"
  			android:fontFamily="monospace"
  			android:hint="Text to replace." />

  	</TableRow>
  	<TableRow>
  		<TextView
  			android:layout_width="wrap_content"
  			android:layout_height="wrap_content"
 			android:text = "With:"
 			android:gravity="right"
 			android:layout_marginRight="5dip"/>
  		<EditText
  			android:id="@+id/new_alias_post"
  			android:layout_width="0dip"
  			android:layout_weight="1"
  			android:layout_height="wrap_content"
  			android:fontFamily="monospace"
  			android:inputType="textMultiLine"
  			android:minLines="2"
  			android:maxLines="6"
  			android:hint="Replace with this." />

  	</TableRow>
  	<TableRow>
  		<TextView
  			android:layout_width="wrap_content"
  			android:layout_height="wrap_content"
 			android:text="Preview:"
 			android:gravity="right"
 			android:layout_marginRight="5dip"/>
  		<TextView
  			android:id="@+id/alias_send_preview"
  			android:layout_width="0dip"
  			android:layout_weight="1"
  			android:layout_height="wrap_content"
  			android:textColor="@color/chrome_title_text"
  			android:textSize="13sp"
  			android:fontFamily="monospace"
  			android:background="@color/chrome_preview"
  			android:padding="6dip"
  			android:text="Type a pattern to preview what is sent to the server." />
  	</TableRow>

  </TableLayout>
  <RelativeLayout
  			android:layout_width="match_parent"
  			android:layout_height="wrap_content"
  			android:layout_marginTop="5dip"
  			>

  				<CheckBox
  					android:id="@+id/carrot"
  					android:layout_alignParentLeft="true"
  					android:layout_alignParentRight="true"
  					android:layout_alignParentTop="true"
  					android:layout_marginLeft="30dip"
  					android:layout_width="wrap_content"
  					android:layout_height="wrap_content"
  					android:textStyle="bold"
  					android:textSize="15dip"
  					android:text="Matches start of Line (^)"
  					android:layout_marginRight="30dip"
  					android:checked="false"/>
  				<CheckBox
  					android:id="@+id/dollar"
  					android:layout_alignParentLeft="true"
  					android:layout_alignParentRight="true"
  					android:layout_below="@id/carrot"
  					android:layout_marginRight="30dip"
  					android:layout_marginLeft="30dip"
  					android:layout_width="wrap_content"
  					android:layout_height="wrap_content"
  					android:textStyle="bold"
  					android:textSize="15dip"
  					android:text="Matches end of line ($)"
  					android:checked="false"/>
  				<CheckBox
  				  	android:id="@+id/enabledcheck"
  					android:layout_alignParentLeft="true"
  					android:layout_alignParentRight="true"
  					android:layout_below="@id/dollar"
  					android:layout_marginRight="30dip"
  					android:layout_marginLeft="30dip"
  					android:layout_width="wrap_content"
  					android:layout_height="wrap_content"
  					android:textStyle="bold"
  					android:textSize="15dip"
  					android:text="Enabled"
  					android:checked="true"/>
  				<TextView
  					android:id="@+id/local_echo_label"
  					android:layout_alignParentLeft="true"
  					android:layout_alignParentRight="true"
  					android:layout_below="@id/enabledcheck"
  					android:layout_marginLeft="30dip"
  					android:layout_marginRight="30dip"
  					android:layout_marginTop="8dip"
  					android:layout_width="wrap_content"
  					android:layout_height="wrap_content"
  					android:textStyle="bold"
  					android:textSize="15dip"
  					android:text="Local echo"/>
  				<Spinner
  					android:id="@+id/local_echo_spinner"
  					android:layout_alignParentLeft="true"
  					android:layout_alignParentRight="true"
  					android:layout_below="@id/local_echo_label"
  					android:layout_marginLeft="30dip"
  					android:layout_marginRight="30dip"
  					android:layout_width="match_parent"
  					android:layout_height="wrap_content"/>

  		</RelativeLayout>
  <TextView
  		android:id="@+id/alias_setvariable_label"
  		android:layout_width="match_parent"
  		android:layout_height="wrap_content"
  		android:layout_marginTop="12dip"
  		android:layout_marginLeft="10dip"
  		android:layout_marginRight="10dip"
  		android:textStyle="bold"
  		android:textSize="15dip"
  		android:text="Set Variable"/>
  <TextView
  		android:layout_width="match_parent"
  		android:layout_height="wrap_content"
  		android:layout_marginLeft="10dip"
  		android:layout_marginRight="10dip"
  		android:layout_marginBottom="4dip"
  		android:textSize="12sp"
  		android:textColor="@color/chrome_description"
  		android:text="Runs when this alias matches, in addition to With. Same modes as a trigger (Set, Add number, Subtract, Append, Unset). $1 is what you typed."/>
  <LinearLayout
  		android:id="@+id/alias_setvariable_list"
  		android:layout_width="match_parent"
  		android:layout_height="wrap_content"
  		android:orientation="vertical"/>
  <Button
  		android:id="@+id/alias_add_setvariable"
  		android:layout_width="match_parent"
  		android:layout_height="wrap_content"
  		android:layout_marginLeft="10dip"
  		android:layout_marginRight="10dip"
  		android:minHeight="44dip"
  		android:text="Add Set Variable"/>
  </LinearLayout>
  </ScrollView>

  <LinearLayout
  	android:id="@+id/editor_button_bar"
  	android:layout_width="match_parent"
  	android:layout_height="wrap_content"
  	android:orientation="horizontal"
  	android:gravity="center"
  	android:background="@color/chrome_title_bar"
  	android:paddingLeft="6dip"
  	android:paddingRight="6dip"
  	android:paddingTop="6dip"
  	android:paddingBottom="6dip">
	  <Button
	    android:layout_width="0dip"
	  	android:layout_height="wrap_content"
	  	android:layout_weight="1"
	  	android:minHeight="44dip"
	  	android:id="@+id/new_alias_cancel"
	  	android:text="Cancel" />
	  <Button
	  	android:id="@+id/alias_editor_help_button"
	  	android:layout_width="wrap_content"
	  	android:layout_height="wrap_content"
	  	android:minHeight="44dip"
	  	android:minWidth="52dip"
	  	android:layout_marginLeft="6dip"
	  	android:background="@drawable/editor_more_button_bg"
	  	android:textColor="@color/chrome_chip_text"
	  	android:textSize="16dip"
	  	android:textStyle="bold"
	  	android:text="?" />
	  <Button
	  	android:layout_width="0dip"
	  	android:layout_height="wrap_content"
	  	android:layout_weight="1"
	  	android:minHeight="44dip"
	  	android:layout_marginLeft="6dip"
	  	android:text="Done"
	  	android:id="@+id/new_alias_done_button"/>
  </LinearLayout>

</LinearLayout>
