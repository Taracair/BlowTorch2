<?xml version="1.0" encoding="UTF-8"?>

<!--
  One entry in the Alias / Trigger / Timer lists.

  Two lines instead of a 64dip block: name on top, pattern or interval under it,
  with the action icons centred on the right. The old row carried a coloured dot
  that said the same thing as the toolbar's lightbulb; the dot is gone and the
  toggle icon's own tint carries enabled/disabled now. The mini icon slot stays
  for timers, where it means playing / paused / stopped and is not a duplicate.
-->
<RelativeLayout
  	xmlns:android="http://schemas.android.com/apk/res/android"
  	android:layout_width="match_parent"
  	android:layout_height="wrap_content"
  	android:minHeight="48dip"
  	android:paddingTop="5dip"
  	android:paddingBottom="5dip"
  	android:paddingLeft="10dip"
  	android:paddingRight="6dip"
  	android:background="@drawable/editor_row_selector"
  	android:id="@+id/root">

  	 <LinearLayout
  	     android:id="@+id/toolbarholder"
  	     android:layout_width="wrap_content"
  	     android:layout_height="wrap_content"
  	     android:layout_alignParentTop="true"
  	     android:layout_alignParentBottom="true"
  	     android:layout_alignParentRight="true"
  	     android:gravity="center_vertical|right"
  	     android:orientation="horizontal"
  	     android:paddingLeft="6dip"/>

  	<ImageView
  		android:layout_width="wrap_content"
  		android:layout_height="wrap_content"
  		android:layout_centerVertical="true"
  		android:layout_toLeftOf="@id/toolbarholder"
  		android:layout_marginRight="6dip"
  		android:focusable="false"
  		android:focusableInTouchMode="false"
  		android:id="@+id/icon"/>

  	 <TextView
  		android:id="@+id/infoTitle"
  		android:layout_width="match_parent"
  		android:layout_height="wrap_content"
  		android:layout_alignParentTop="true"
  		android:layout_toLeftOf="@id/icon"
  		android:text="Main Title"
  		android:focusable="false"
  		android:focusableInTouchMode="false"
  		android:lines="1"
  		android:ellipsize="end"
  		android:textSize="16dip"
  		android:textColor="#FFF2F4F6"
  		android:textStyle="bold"/>

  	 <TextView
  		android:layout_width="match_parent"
  		android:layout_height="wrap_content"
  		android:layout_toLeftOf="@id/icon"
  		android:layout_below="@id/infoTitle"
  		android:focusable="false"
  		android:focusableInTouchMode="false"
  		android:text="Extended Info"
  		android:paddingTop="1dip"
  		android:paddingRight="6dip"
  		android:textSize="12dip"
  		android:textColor="#FF9AA3AD"
  		android:lines="1"
  		android:ellipsize="end"
  		android:id="@+id/infoExtended"/>

 </RelativeLayout>
