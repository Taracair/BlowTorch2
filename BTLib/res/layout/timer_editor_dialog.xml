<?xml version="1.0" encoding="UTF-8"?>

<!-- Opaque full-screen Family A shell (same as the TRIGGERS list). Pair with
     EditorDialogChrome.fullScreenTheme + applyFullScreen. -->
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/newtriggerlayout"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@color/chrome_body"
  android:orientation="vertical">

  <TextView
		android:id="@+id/titlebar"
		style="@style/BlowTorch.Chrome.Title"
		android:text="TIMER EDITOR"/>

  <ScrollView
  	android:layout_width="match_parent"
  	android:layout_height="0dip"
  	android:layout_weight="1"
  	android:fillViewport="true"
  	android:id="@+id/timer_editor_scroll_container">
  	<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
  		<TableLayout android:layout_width="match_parent" android:layout_height="wrap_content"  android:stretchColumns="1">
  			<TableRow>
  				<TextView
  					android:text="Name:"
  					android:layout_marginLeft="10dip"
  					android:layout_marginRight="5dip"
  					android:layout_width="wrap_content"
  					android:gravity="right"/>
  				<EditText
  					android:id="@+id/timer_editor_name"
  					android:layout_marginRight="10dip"
  					android:layout_width="0dip"
  					android:layout_weight="1"
  					android:singleLine="true"
  					android:hint="Timer Function"
  					android:inputType="text"/>
  			</TableRow>
  			<TableRow>
  				<TextView
  					android:text="Group:"
  					android:layout_marginLeft="10dip"
  					android:layout_marginRight="5dip"
  					android:layout_width="wrap_content"
  					android:gravity="right"/>
  				<LinearLayout
  					android:layout_width="0dip"
  					android:layout_height="wrap_content"
  					android:layout_weight="1"
  					android:layout_marginRight="10dip"
  					android:orientation="vertical">
					<Spinner
						android:id="@+id/timer_editor_group_spinner"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:minHeight="44dip"
						android:popupBackground="#FF000000"/>
  					<AutoCompleteTextView
  						android:id="@+id/timer_editor_group"
  						android:layout_width="match_parent"
  						android:layout_height="wrap_content"
  						android:singleLine="true"
  						android:hint="or type a new group"
  						android:completionThreshold="1"
  						android:inputType="text"/>
  				</LinearLayout>
  			</TableRow>
  		</TableLayout>
  		<!--
  			Duration used to be a single "Seconds:" box, so a half-hour timer meant doing the
  			arithmetic yourself. Hours/minutes/seconds are still stored as one total in
  			seconds; these three boxes are only a face on it, and the presets cover the
  			durations people actually type.
  		-->
  		<LinearLayout
  			android:layout_width="match_parent"
  			android:layout_height="wrap_content"
  			android:orientation="vertical"
  			android:layout_marginLeft="10dip"
  			android:layout_marginRight="10dip"
  			android:layout_marginTop="6dip"
  			android:layout_marginBottom="10dip"
  			android:paddingTop="4dip"
  			android:paddingBottom="4dip">
  			<LinearLayout
  				android:layout_width="match_parent"
  				android:layout_height="wrap_content"
  				android:orientation="horizontal"
  				android:gravity="center_vertical">
  				<TextView
  					android:text="Every:"
  					android:layout_marginRight="8dip"
  					android:layout_width="wrap_content"
  					android:layout_height="wrap_content"
  					android:gravity="center_vertical"/>
  				<EditText
  					android:id="@+id/timer_editor_hours"
  					android:layout_width="0dip"
  					android:layout_weight="1"
  					android:layout_height="wrap_content"
  					android:minHeight="48dip"
  					android:paddingTop="10dip"
  					android:paddingBottom="10dip"
  					android:gravity="center"
  					android:singleLine="true"
  					android:hint="0"
  					android:contentDescription="Hours"
  					android:inputType="number"/>
  				<TextView
  					android:text="h"
  					android:layout_marginLeft="3dip"
  					android:layout_marginRight="6dip"
  					android:layout_width="wrap_content"
  					android:layout_height="wrap_content"
  					android:gravity="center_vertical"/>
  				<EditText
  					android:id="@+id/timer_editor_minutes"
  					android:layout_width="0dip"
  					android:layout_weight="1"
  					android:layout_height="wrap_content"
  					android:minHeight="48dip"
  					android:paddingTop="10dip"
  					android:paddingBottom="10dip"
  					android:gravity="center"
  					android:singleLine="true"
  					android:hint="0"
  					android:contentDescription="Minutes"
  					android:inputType="number"/>
  				<TextView
  					android:text="m"
  					android:layout_marginLeft="3dip"
  					android:layout_marginRight="6dip"
  					android:layout_width="wrap_content"
  					android:layout_height="wrap_content"
  					android:gravity="center_vertical"/>
  				<EditText
  					android:id="@+id/timer_editor_seconds"
  					android:layout_width="0dip"
  					android:layout_weight="1"
  					android:layout_height="wrap_content"
  					android:minHeight="48dip"
  					android:paddingTop="10dip"
  					android:paddingBottom="10dip"
  					android:gravity="center"
  					android:singleLine="true"
  					android:hint="30"
  					android:contentDescription="Seconds"
  					android:inputType="number"/>
  				<TextView
  					android:text="s"
  					android:layout_marginLeft="3dip"
  					android:layout_width="wrap_content"
  					android:layout_height="wrap_content"
  					android:gravity="center_vertical"/>
  			</LinearLayout>
  			<LinearLayout
  				android:id="@+id/timer_editor_presets"
  				android:layout_width="match_parent"
  				android:layout_height="wrap_content"
  				android:orientation="horizontal"
  				android:layout_marginTop="4dip"/>
  			<LinearLayout
  				android:layout_width="match_parent"
  				android:layout_height="wrap_content"
  				android:orientation="horizontal"
  				android:gravity="center_vertical"
  				android:layout_marginTop="2dip">
  				<CheckBox
  					android:id="@+id/timer_repeat_checkbox"
  					android:text="Repeat?"
  					android:textSize="13sp"
  					android:layout_width="wrap_content"
  					android:layout_height="wrap_content"
  					android:layout_gravity="center_vertical"/>
  				<TextView
  					android:id="@+id/timer_editor_duration_summary"
  					android:layout_width="0dip"
  					android:layout_weight="1"
  					android:layout_height="wrap_content"
  					android:layout_marginLeft="10dip"
  					android:textSize="13sp"
  					android:textColor="@color/chrome_description"
  					android:gravity="right|center_vertical"/>
  			</LinearLayout>
  		</LinearLayout>
    		<LinearLayout
  			android:id="@+id/timer_conditions_header"
  			android:layout_width="match_parent"
  			android:layout_height="wrap_content"
  			android:layout_marginLeft="10dip"
  			android:layout_marginRight="10dip"
  			android:layout_marginTop="8dip"
  			android:orientation="horizontal"
  			android:gravity="center_vertical"
  			android:minHeight="34dip"
  			android:background="@drawable/sensor_section_bg"
  			android:paddingLeft="10dip"
  			android:paddingRight="4dip">
  			<TextView
  				android:layout_width="0dip"
  				android:layout_height="wrap_content"
  				android:layout_weight="1"
  				android:text="CONDITIONS"
  				android:gravity="center_vertical"
  				android:textStyle="bold"
  				android:textAllCaps="true"
  				android:textSize="12dip"
  				android:letterSpacing="0.06"
  				android:textColor="@color/chrome_section_text"/>
  			<Spinner
  				android:id="@+id/timer_conditions_op"
  				android:layout_width="wrap_content"
  				android:layout_height="wrap_content"
  				android:minWidth="72dip"
  				android:popupBackground="#FF000000"/>
  		</LinearLayout>
  		<TextView
  			android:id="@+id/timer_conditions_hint"
  			android:layout_width="match_parent"
  			android:layout_height="wrap_content"
  			android:layout_marginLeft="10dip"
  			android:layout_marginRight="10dip"
  			android:paddingLeft="6dip"
  			android:paddingRight="6dip"
  			android:paddingTop="6dip"
  			android:paddingBottom="6dip"
  			android:textColor="@color/chrome_description"
  			android:textSize="12sp"
  			android:text="No conditions — always runs when the timer fires."/>
  		<TableLayout
  			android:id="@+id/timer_conditions_table"
  			android:layout_width="match_parent"
  			android:layout_height="wrap_content"
  			android:layout_marginLeft="10dip"
  			android:layout_marginRight="10dip"
  			android:stretchColumns="0"
  			android:shrinkColumns="0"/>
  		<Button
  			android:id="@+id/timer_new_condition"
  			android:layout_width="match_parent"
  			android:layout_height="wrap_content"
  			android:layout_marginLeft="10dip"
  			android:layout_marginRight="10dip"
  			android:layout_marginBottom="8dip"
  			android:text="Add Condition"/>
  		<TextView android:layout_width="match_parent"
  					android:layout_height="wrap_content"
  					android:minHeight="34dip"
  					android:gravity="center_vertical"
  					android:paddingLeft="10dip"
  					android:paddingRight="10dip"
  					android:text="EXECUTE ACTIONS"
  					android:layout_marginLeft="10dip"
  					android:layout_marginRight="10dip"
  					android:background="@drawable/sensor_section_bg"
  					android:textAllCaps="true"
  					android:textSize="12dip"
  					android:letterSpacing="0.06"
  					android:textStyle="bold"
  					android:textColor="@color/chrome_section_text"/>
  		<LinearLayout
  			android:id="@+id/timer_action_list"
  			android:layout_width="match_parent"
  			android:layout_height="wrap_content"
  			android:layout_marginLeft="10dip"
  			android:layout_marginRight="10dip"
  			android:orientation="vertical"/>
  		<Button
  			android:id="@+id/timer_new_notification"
  			android:layout_width="match_parent"
  			android:layout_height="wrap_content"
  			android:layout_marginLeft="10dip"
  			android:layout_marginRight="10dip"
  			android:layout_marginTop="4dip"
  			android:layout_marginBottom="8dip"
  			android:text="New Action"/>
  	</LinearLayout>
  	
  </ScrollView>

  <LinearLayout
  	android:id="@+id/editor_button_bar"
  	android:layout_width="match_parent"
  	android:layout_height="wrap_content"
  	android:orientation="horizontal"
  	android:gravity="center"
  	android:background="@color/chrome_title_bar"
  	android:paddingLeft="6dip"
  	android:paddingRight="6dip"
  	android:paddingTop="6dip"
  	android:paddingBottom="6dip">
	  <Button
	    android:layout_width="0dip"
	  	android:layout_height="wrap_content"
	  	android:layout_weight="1"
	  	android:minHeight="44dip"
	  	android:id="@+id/timer_editor_cancel"
	  	android:text="Cancel" />
	  <Button
	  	android:id="@+id/timer_editor_help_button"
	  	android:layout_width="wrap_content"
	  	android:layout_height="wrap_content"
	  	android:minHeight="44dip"
	  	android:minWidth="52dip"
	  	android:layout_marginLeft="6dip"
	  	android:background="@drawable/editor_more_button_bg"
	  	android:textColor="@color/chrome_chip_text"
	  	android:textSize="16dip"
	  	android:textStyle="bold"
	  	android:text="?" />
	  <Button
	  	android:layout_width="0dip"
	  	android:layout_height="wrap_content"
	  	android:layout_weight="1"
	  	android:minHeight="44dip"
	  	android:layout_marginLeft="6dip"
	  	android:text="Done"
	  	android:id="@+id/timer_editor_done_button"/>
  </LinearLayout>

</LinearLayout>
