<?xml version="1.0" encoding="UTF-8"?>

<!-- Vertical shell: title -> fields -> Cancel/More/Done directly under the
     content, not pinned to the bottom of a 94%-tall dialog. Pair with
     EditorDialogChrome.applyFloatingWrapContentHeight. The alias editor has
     been this shape for a while; these two were still a RelativeLayout with
     the buttons alignParentBottom, so a short timer left a band of empty
     dialog and the buttons sat down by the navigation bar. -->
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/newtriggerlayout"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:layout_marginLeft="4dip"
  android:layout_marginRight="4dip"
  android:orientation="vertical">

  <TextView
		android:id="@+id/titlebar"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:text="TIMER EDITOR"
		android:textColor="#FF333333"
		android:background="#FF999999"
		android:textSize="15dip"
		android:textStyle="bold"
		android:gravity="center"/>

  <ScrollView
  	android:layout_width="match_parent"
  	android:layout_height="0dip"
  	android:layout_weight="1"
  	android:fillViewport="true"
  	android:id="@+id/timer_editor_scroll_container">
  	<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
  		<TableLayout android:layout_width="match_parent" android:layout_height="wrap_content"  android:stretchColumns="1">
  			<TableRow>
  				<TextView
  					android:text="Name:"
  					android:layout_marginLeft="10dip"
  					android:layout_marginRight="5dip"
  					android:layout_width="wrap_content"
  					android:gravity="right"/>
  				<EditText
  					android:id="@+id/timer_editor_name"
  					android:layout_marginRight="10dip"
  					android:layout_width="0dip"
  					android:layout_weight="1"
  					android:singleLine="true"
  					android:hint="Timer Function"
  					android:inputType="text"/>
  			</TableRow>
  			<TableRow>
  				<TextView
  					android:text="Group:"
  					android:layout_marginLeft="10dip"
  					android:layout_marginRight="5dip"
  					android:layout_width="wrap_content"
  					android:gravity="right"/>
  				<LinearLayout
  					android:layout_width="0dip"
  					android:layout_height="wrap_content"
  					android:layout_weight="1"
  					android:layout_marginRight="10dip"
  					android:orientation="vertical">
					<Spinner
						android:id="@+id/timer_editor_group_spinner"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:minHeight="44dip"
						android:popupBackground="#FF000000"/>
  					<AutoCompleteTextView
  						android:id="@+id/timer_editor_group"
  						android:layout_width="match_parent"
  						android:layout_height="wrap_content"
  						android:singleLine="true"
  						android:hint="or type a new group"
  						android:completionThreshold="1"
  						android:inputType="text"/>
  				</LinearLayout>
  			</TableRow>
  		</TableLayout>
  		<!--
  			Duration used to be a single "Seconds:" box, so a half-hour timer meant doing the
  			arithmetic yourself. Hours/minutes/seconds are still stored as one total in
  			seconds; these three boxes are only a face on it, and the presets cover the
  			durations people actually type.
  		-->
  		<LinearLayout
  			android:layout_width="match_parent"
  			android:layout_height="wrap_content"
  			android:orientation="vertical"
  			android:layout_marginLeft="10dip"
  			android:layout_marginRight="10dip"
  			android:layout_marginTop="6dip"
  			android:layout_marginBottom="10dip"
  			android:paddingTop="4dip"
  			android:paddingBottom="4dip">
  			<LinearLayout
  				android:layout_width="match_parent"
  				android:layout_height="wrap_content"
  				android:orientation="horizontal"
  				android:gravity="center_vertical">
  				<TextView
  					android:text="Every:"
  					android:layout_marginRight="8dip"
  					android:layout_width="wrap_content"
  					android:layout_height="wrap_content"
  					android:gravity="center_vertical"/>
  				<EditText
  					android:id="@+id/timer_editor_hours"
  					android:layout_width="0dip"
  					android:layout_weight="1"
  					android:layout_height="wrap_content"
  					android:minHeight="48dip"
  					android:paddingTop="10dip"
  					android:paddingBottom="10dip"
  					android:gravity="center"
  					android:singleLine="true"
  					android:hint="0"
  					android:contentDescription="Hours"
  					android:inputType="number"/>
  				<TextView
  					android:text="h"
  					android:layout_marginLeft="3dip"
  					android:layout_marginRight="6dip"
  					android:layout_width="wrap_content"
  					android:layout_height="wrap_content"
  					android:gravity="center_vertical"/>
  				<EditText
  					android:id="@+id/timer_editor_minutes"
  					android:layout_width="0dip"
  					android:layout_weight="1"
  					android:layout_height="wrap_content"
  					android:minHeight="48dip"
  					android:paddingTop="10dip"
  					android:paddingBottom="10dip"
  					android:gravity="center"
  					android:singleLine="true"
  					android:hint="0"
  					android:contentDescription="Minutes"
  					android:inputType="number"/>
  				<TextView
  					android:text="m"
  					android:layout_marginLeft="3dip"
  					android:layout_marginRight="6dip"
  					android:layout_width="wrap_content"
  					android:layout_height="wrap_content"
  					android:gravity="center_vertical"/>
  				<EditText
  					android:id="@+id/timer_editor_seconds"
  					android:layout_width="0dip"
  					android:layout_weight="1"
  					android:layout_height="wrap_content"
  					android:minHeight="48dip"
  					android:paddingTop="10dip"
  					android:paddingBottom="10dip"
  					android:gravity="center"
  					android:singleLine="true"
  					android:hint="30"
  					android:contentDescription="Seconds"
  					android:inputType="number"/>
  				<TextView
  					android:text="s"
  					android:layout_marginLeft="3dip"
  					android:layout_width="wrap_content"
  					android:layout_height="wrap_content"
  					android:gravity="center_vertical"/>
  			</LinearLayout>
  			<LinearLayout
  				android:id="@+id/timer_editor_presets"
  				android:layout_width="match_parent"
  				android:layout_height="wrap_content"
  				android:orientation="horizontal"
  				android:layout_marginTop="4dip"/>
  			<LinearLayout
  				android:layout_width="match_parent"
  				android:layout_height="wrap_content"
  				android:orientation="horizontal"
  				android:gravity="center_vertical"
  				android:layout_marginTop="2dip">
  				<CheckBox
  					android:id="@+id/timer_repeat_checkbox"
  					android:text="Repeat?"
  					android:textSize="13sp"
  					android:layout_width="wrap_content"
  					android:layout_height="wrap_content"
  					android:layout_gravity="center_vertical"/>
  				<TextView
  					android:id="@+id/timer_editor_duration_summary"
  					android:layout_width="0dip"
  					android:layout_weight="1"
  					android:layout_height="wrap_content"
  					android:layout_marginLeft="10dip"
  					android:textSize="13sp"
  					android:textColor="#FF9AA3AD"
  					android:gravity="right|center_vertical"/>
  			</LinearLayout>
  		</LinearLayout>
    		<LinearLayout
  			android:id="@+id/timer_conditions_header"
  			android:layout_width="match_parent"
  			android:layout_height="wrap_content"
  			android:layout_marginLeft="10dip"
  			android:layout_marginRight="10dip"
  			android:layout_marginTop="8dip"
  			android:orientation="horizontal"
  			android:gravity="center_vertical"
  			android:background="#FF999999"
  			android:paddingLeft="6dip"
  			android:paddingRight="4dip">
  			<TextView
  				android:layout_width="0dip"
  				android:layout_height="wrap_content"
  				android:layout_weight="1"
  				android:text="CONDITIONS (advanced)"
  				android:gravity="center_vertical"
  				android:textStyle="bold"
  				android:textColor="#FF111111"/>
  			<Spinner
  				android:id="@+id/timer_conditions_op"
  				android:layout_width="wrap_content"
  				android:layout_height="wrap_content"
  				android:minWidth="72dip"
  				android:popupBackground="#FF000000"/>
  		</LinearLayout>
  		<TextView
  			android:id="@+id/timer_conditions_note"
  			android:layout_width="match_parent"
  			android:layout_height="wrap_content"
  			android:layout_marginLeft="10dip"
  			android:layout_marginRight="10dip"
  			android:paddingLeft="6dip"
  			android:paddingRight="6dip"
  			android:paddingTop="6dip"
  			android:paddingBottom="2dip"
  			android:textColor="#FFDDDDDD"
  			android:textSize="12sp"
  			android:text="Extra gate when the timer fires — not a substitute for the interval. Checked before responders run. Variables are session sticky notes (Set Variable / Lua SetVariable); use ${name} in alias or action text."/>
  		<TextView
  			android:id="@+id/timer_conditions_hint"
  			android:layout_width="match_parent"
  			android:layout_height="wrap_content"
  			android:layout_marginLeft="10dip"
  			android:layout_marginRight="10dip"
  			android:paddingLeft="6dip"
  			android:paddingRight="6dip"
  			android:paddingBottom="6dip"
  			android:textColor="#FFCCCCCC"
  			android:textSize="12sp"
  			android:text="No conditions — always runs when the timer fires."/>
  		<TableLayout
  			android:id="@+id/timer_conditions_table"
  			android:layout_width="match_parent"
  			android:layout_height="wrap_content"
  			android:layout_marginLeft="10dip"
  			android:layout_marginRight="10dip"
  			android:stretchColumns="0"
  			android:shrinkColumns="0"
  			android:background="@drawable/movemethod_frame"/>
  		<Button
  			android:id="@+id/timer_new_condition"
  			android:layout_width="match_parent"
  			android:layout_height="wrap_content"
  			android:layout_marginLeft="10dip"
  			android:layout_marginRight="10dip"
  			android:layout_marginBottom="8dip"
  			android:text="Add Condition"/>
  		<TextView android:layout_width="match_parent"
  					android:layout_height="wrap_content"
  					android:text="EXECUTE ACTIONS"
  					android:layout_marginLeft="10dip"
  					android:layout_marginRight="10dip"
  					android:background="#FF999999"
  					android:gravity="center"
  					android:textStyle="bold"
  					android:textColor="#FF111111"/>
  		<TableLayout
  			android:id="@+id/timer_notification_table"
  			android:layout_width="match_parent"
  			android:layout_height="wrap_content"
  			android:layout_marginLeft="10dip"
  			android:layout_marginRight="10dip"
  			android:stretchColumns="0"
  			android:shrinkColumns="0"
  			android:background="@drawable/movemethod_frame">
  			<TableRow android:id="@+id/timer_notification_legend">
  				<TextView
  					android:text="TYPE"
  					android:gravity="center"
  					/>
  				<TextView
  					android:text="Window\nOpen"
  					android:gravity="center"
  					android:layout_marginRight="3dip" android:layout_marginLeft="3dip"/>
  				<TextView
  					android:text="Window\nClosed"
  					android:gravity="center"
  					android:layout_marginRight="3dip" android:layout_marginLeft="3dip"/>
  				<TextView
  					android:text="Del"
  					android:id="@+id/timer_delete_responder"
  					android:gravity="center"
  					android:layout_marginRight="1dip" android:layout_marginLeft="1dip"/>
  			</TableRow>
  			<TableRow android:id="@+id/timer_new_responder_row">
  				<Button android:id="@+id/timer_new_notification" android:text="New Action" android:paddingLeft="10dip" android:paddingRight="10dip"/>
  				<TextView android:text=""/>
  				<TextView android:text=""/>
  			</TableRow>
  		</TableLayout>
  	</LinearLayout>
  	
  </ScrollView>

  <!-- Cancel, ?, Done. The ? is help; the lists' "More" is their actions
       overflow, which is a different thing wearing a similar button. -->
  <LinearLayout
  	android:id="@+id/editor_button_bar"
  	android:layout_width="match_parent"
  	android:layout_height="wrap_content"
  	android:orientation="horizontal"
  	android:gravity="center"
  	android:paddingLeft="6dip"
  	android:paddingRight="6dip"
  	android:paddingTop="6dip"
  	android:paddingBottom="6dip">
	  <Button
	    android:layout_width="0dip"
	  	android:layout_height="wrap_content"
	  	android:layout_weight="1"
	  	android:minHeight="44dip"
	  	android:id="@+id/timer_editor_cancel"
	  	android:text="Cancel" />
	  <Button
	  	android:id="@+id/timer_editor_help_button"
	  	android:layout_width="wrap_content"
	  	android:layout_height="wrap_content"
	  	android:minHeight="44dip"
	  	android:minWidth="52dip"
	  	android:layout_marginLeft="6dip"
	  	android:background="@drawable/editor_more_button_bg"
	  	android:textColor="#FFC7CDD4"
	  	android:textSize="16dip"
	  	android:textStyle="bold"
	  	android:text="?" />
	  <Button
	  	android:layout_width="0dip"
	  	android:layout_height="wrap_content"
	  	android:layout_weight="1"
	  	android:minHeight="44dip"
	  	android:layout_marginLeft="6dip"
	  	android:text="Done"
	  	android:id="@+id/timer_editor_done_button"/>
  </LinearLayout>

</LinearLayout>
