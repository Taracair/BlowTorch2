<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/chat_msg_day"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="8dp"
        android:paddingBottom="6dp"
        android:textColor="@color/chrome_section_text"
        android:textSize="11sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/chat_msg_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/chrome_chip_text"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/chat_msg_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="2dp"
        android:textColor="@color/chrome_title_text"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/chat_msg_when"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="2dp"
        android:textColor="@color/chrome_hint"
        android:textSize="10sp" />
</LinearLayout>
