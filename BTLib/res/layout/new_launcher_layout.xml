<?xml version="1.0" encoding="UTF-8"?>
<RelativeLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:id="@+id/launcher_window_content"
	android:layout_height="match_parent"
	android:layout_width="match_parent"
	android:background="#FF16181C">

	<!-- Wordmark lives inside the toolbar, beside the overflow: a separate strip
	     below it spent a band of screen on two lines of text. -->
	<androidx.appcompat.widget.Toolbar
		android:id="@+id/my_toolbar"
		android:layout_width="match_parent"
		android:layout_height="?attr/actionBarSize"
		android:background="?attr/colorPrimary"
		android:elevation="4dp"
		android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
		android:layout_alignParentTop="true"
		app:contentInsetStart="16dp"
		app:popupTheme="@style/ThemeOverlay.AppCompat.Dark">

		<LinearLayout
			android:id="@+id/launcher_header"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:orientation="vertical">

			<TextView
				android:id="@+id/launcher_title"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="@string/launcher_title"
				android:textSize="19sp"
				android:textStyle="bold"
				android:singleLine="true"
				android:textColor="#FFF2F4F6"/>

			<TextView
				android:id="@+id/launcher_tagline"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="@string/launcher_tagline"
				android:textSize="11sp"
				android:singleLine="true"
				android:textColor="#FF9AA3AD"/>
		</LinearLayout>
	</androidx.appcompat.widget.Toolbar>

	<LinearLayout
		android:id="@+id/table_container"
		android:layout_height="wrap_content"
		android:layout_width="match_parent"
		android:layout_alignParentBottom="true"
		android:orientation="vertical"
		android:background="#FF1E2126"
		android:paddingLeft="12dip"
		android:paddingRight="12dip"
		android:paddingTop="8dip"
		android:paddingBottom="8dip">

		<LinearLayout
			android:id="@+id/test_update"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:visibility="gone">
			<TextView
				android:id="@+id/update_label"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:gravity="center"
				android:paddingTop="4dip"
				android:paddingBottom="4dip"
				android:text="Test"
				android:textSize="14sp"
				android:textColor="#FFF2F4F6"
				android:textStyle="bold"/>
		</LinearLayout>

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="horizontal">

			<androidx.appcompat.widget.AppCompatButton
				android:id="@+id/user_guide_button"
				style="@style/LauncherActionButton"
				android:layout_height="wrap_content"
				android:layout_width="0dip"
				android:layout_weight="1"
				android:text="@string/launcher_btn_guide"/>

			<androidx.appcompat.widget.AppCompatButton
				android:id="@+id/new_connection"
				style="@style/LauncherActionButton"
				android:layout_height="wrap_content"
				android:layout_width="0dip"
				android:layout_weight="1"
				android:text="@string/launcher_btn_new"/>
		</LinearLayout>
	</LinearLayout>

	<!-- help_button retained as gone stub so older code paths do not NPE -->
	<androidx.appcompat.widget.AppCompatButton
		android:id="@+id/help_button"
		android:layout_width="0dip"
		android:layout_height="0dip"
		android:visibility="gone"/>

	<FrameLayout
		android:id="@+id/timer_frame"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:layout_margin="0dip"
		android:padding="0dip"
		android:layout_above="@id/table_container"
		android:layout_below="@id/my_toolbar">

		<ListView
			android:id="@+id/connection_list"
			android:layout_height="match_parent"
			android:layout_width="match_parent"
			android:listSelector="@drawable/launcher_row_selector"
			android:cacheColorHint="#00000000"
			android:background="#FF16181C"
			android:divider="#FF2A2E35"
			android:dividerHeight="1dip"
			android:paddingLeft="0dip"
			android:paddingRight="0dip"/>

		<TextView
			android:id="@+id/launcher_empty"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:text="No connections.\nTap New MUD below to add a server."
			android:textColor="#FFC7CDD4"
			android:background="#FF16181C"
			android:padding="24dip"
			android:textStyle="bold"
			android:textSize="18sp"
			android:gravity="center"/>
	</FrameLayout>

</RelativeLayout>
