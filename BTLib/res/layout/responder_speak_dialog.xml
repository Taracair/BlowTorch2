<?xml version="1.0" encoding="UTF-8"?>

<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/newspeaklayout"
  android:layout_width="wrap_content"
  android:layout_height="wrap_content"
  android:minWidth="300dip"
  android:orientation="vertical">

  <TextView
		android:id="@+id/titlebar"
		android:layout_width="match_parent"
		android:layout_height="42dip"
		android:text="SPEAK RESPONDER"
		android:textColor="@color/chrome_title_text"
		android:background="@color/chrome_title_bar"
		android:textSize="14dip"
		android:textStyle="bold"
		android:textAllCaps="true"
		android:gravity="center"/>

  <LinearLayout
  	android:layout_width="match_parent"
  	android:layout_height="wrap_content"
  	android:orientation="vertical">

  <TableLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:shrinkColumns="0" android:stretchColumns="1">
  	<TableRow>
  		<TextView android:text="Say:"/>
  		<EditText android:id="@+id/responder_speak_message"/>
  	</TableRow>
  </TableLayout>

  <!-- Test is a button and not something that happens when the dialog closes.
       Speaking on save meant a line was read out whenever the editor was shut,
       including by someone else closing it. You decide when the phone talks. -->
  <LinearLayout
  	android:layout_width="match_parent"
  	android:layout_height="wrap_content"
  	android:orientation="horizontal">

    <Button
    	android:id="@+id/responder_speak_test"
    	android:layout_width="0dip"
    	android:layout_weight="1"
    	android:layout_height="wrap_content"
    	android:text="▶ Say it now" />

    <Button
    	android:id="@+id/responder_speak_help"
    	android:layout_width="52dip"
    	android:layout_height="wrap_content"
    	android:text="?" />
  </LinearLayout>

  <CheckBox
  	android:id="@+id/responder_speak_interrupt"
  	android:layout_width="match_parent"
  	android:layout_height="wrap_content"
  	android:text="Say this at once, cutting off the previous line" />

  <CheckBox
  	android:id="@+id/responder_speak_warn"
  	android:layout_width="match_parent"
  	android:layout_height="wrap_content"
  	android:text="Warn me if the volume is off" />

  <TextView
  	android:id="@+id/responder_speak_status"
  	android:layout_width="match_parent"
  	android:layout_height="wrap_content"
  	android:layout_marginLeft="6dip"
  	android:layout_marginRight="6dip"
  	android:textSize="12dip"
  	android:text="$1, $word and variables are filled in from the match." />
  </LinearLayout>

  <LinearLayout
  	android:layout_width="match_parent"
  	android:layout_height="wrap_content"
  	android:orientation="horizontal">
    <Button
    	android:layout_width="0dip"
  		android:layout_height="wrap_content"
  		android:layout_weight="1"
  		android:id="@+id/responder_speak_cancel"
  		android:text="Cancel" />
    <Button
  		android:layout_width="0dip"
  		android:layout_height="wrap_content"
  		android:layout_weight="1"
  		android:text="Done"
  		android:id="@+id/responder_speak_done_button"/>
  </LinearLayout>

</LinearLayout>
