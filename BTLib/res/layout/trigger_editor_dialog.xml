<?xml version="1.0" encoding="UTF-8"?>

<!-- Opaque full-screen Family A shell (same as the TRIGGERS list). Pair with
     EditorDialogChrome.fullScreenTheme + applyFullScreen. -->
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/newtriggerlayout"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@color/chrome_body"
  android:orientation="vertical">

  <TextView
		android:id="@+id/titlebar"
		style="@style/BlowTorch.Chrome.Title"
		android:text="TRIGGER EDITOR"/>

  <ScrollView
  	android:layout_width="match_parent"
  	android:layout_height="0dip"
  	android:layout_weight="1"
  	android:fillViewport="true"
  	android:id="@+id/trigger_editor_scroll_container">
  	<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
  		<TableLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:stretchColumns="1" android:shrinkColumns="1">
  			<TableRow>
  				<TextView
  					android:text="Name:"
  					android:paddingLeft="10dip"/>
  				<EditText
  					android:id="@+id/trigger_editor_name"
  					android:hint=""
  					android:layout_marginRight="10dip"
  					android:layout_width="0dip"
  					android:layout_weight="1"
  					android:singleLine="true"
  					android:inputType="text"/>
  			</TableRow>
  			<TableRow>
  				<TextView
  					android:text="Group:"
  					android:paddingLeft="10dip"/>
  				<LinearLayout
  					android:layout_width="0dip"
  					android:layout_height="wrap_content"
  					android:layout_weight="1"
  					android:layout_marginRight="10dip"
  					android:orientation="horizontal"
  					android:gravity="center_vertical">
  					<AutoCompleteTextView
  						android:id="@+id/trigger_editor_group"
  						android:hint="optional, e.g. combat"
  						android:layout_width="0dip"
  						android:layout_height="wrap_content"
  						android:layout_weight="1"
  						android:singleLine="true"
  						android:completionThreshold="1"
  						android:inputType="text"/>
  					<Spinner
  						android:id="@+id/trigger_editor_group_spinner"
  						android:layout_width="48dip"
  						android:layout_height="wrap_content"
  						android:minHeight="40dip"
  						android:popupBackground="#FF000000"/>
  				</LinearLayout>
  			</TableRow>
  			<TableRow>
  				<TextView
  					android:text="Fires on:"
  					android:paddingLeft="10dip"/>
  				<Spinner
  					android:id="@+id/trigger_editor_source_spinner"
  					android:layout_marginRight="10dip"
  					android:layout_width="0dip"
  					android:layout_weight="1"
  					android:minHeight="40dip"
  					android:popupBackground="#FF000000"/>
  			</TableRow>
  			<TableRow>
  				<TextView
  					android:text="Pattern:"
  					android:paddingLeft="10dip"/>
  				<EditText
  					android:id="@+id/trigger_editor_pattern"
  					android:hint=""
  					android:layout_marginRight="10dip"
  					android:layout_width="0dip"
  					android:layout_weight="1"
  					android:fontFamily="monospace"
  					android:inputType="textMultiLine"
  					android:minLines="2"
  					android:maxLines="8"
  					android:scrollHorizontally="false"/>
  			</TableRow>
  		</TableLayout>
  		<!-- Outside the TableLayout: TableRow ignores maxLines, so a long
  		     one-line regex grew this cell to the full dialog and buried
  		     New Action. Fold is applied in TriggerEditorDialog. -->
  		<TextView
  			android:id="@+id/trigger_preview_toggle"
  			android:layout_width="match_parent"
  			android:layout_height="wrap_content"
  			android:paddingLeft="10dip"
  			android:paddingRight="10dip"
  			android:paddingTop="8dip"
  			android:paddingBottom="4dip"
  			android:text="Preview"
  			android:textColor="@color/chrome_section_text"/>
  		<TextView
  			android:id="@+id/trigger_match_preview"
  			android:layout_width="match_parent"
  			android:layout_height="wrap_content"
  			android:layout_marginLeft="10dip"
  			android:layout_marginRight="10dip"
  			android:textColor="@color/chrome_title_text"
  			android:textSize="13sp"
  			android:fontFamily="monospace"
  			android:background="@color/chrome_preview"
  			android:padding="6dip"
			android:maxLines="3"
			android:ellipsize="end"
			android:text="Enter a pattern to preview what the trigger watches for."/>
		<TextView
			android:id="@+id/trigger_preview_expand"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginLeft="10dip"
			android:layout_marginRight="10dip"
			android:paddingTop="2dip"
			android:paddingBottom="6dip"
			android:text="Show all"
			android:textSize="12sp"
			android:textColor="@color/chrome_description"
			android:clickable="true"
			android:focusable="true"
			android:visibility="gone"/>
  		<LinearLayout
  			android:layout_width="match_parent"
  			android:layout_height="wrap_content"
  			android:layout_marginLeft="10dip"
  			android:layout_marginRight="10dip"
  			android:layout_marginTop="4dip"
  			android:layout_marginBottom="4dip"
  			android:gravity="center"
  			android:orientation="horizontal">
  			<CheckBox
  				android:id="@+id/trigger_literal_checkbox"
  				android:text="Literal?"
  				android:textSize="13sp"
  				android:layout_width="wrap_content"
  				android:layout_height="wrap_content"
  				android:layout_marginRight="16dip"/>
  			<CheckBox
  				android:id="@+id/trigger_once_checkbox"
  				android:text="Fire Once?"
  				android:textSize="13sp"
  				android:layout_width="wrap_content"
  				android:layout_height="wrap_content"/>
  		</LinearLayout>
    		<LinearLayout
  			android:id="@+id/trigger_conditions_header"
  			android:layout_width="match_parent"
  			android:layout_height="wrap_content"
  			android:layout_marginLeft="10dip"
  			android:layout_marginRight="10dip"
  			android:layout_marginTop="8dip"
  			android:orientation="horizontal"
  			android:gravity="center_vertical"
  			android:minHeight="34dip"
  			android:background="@drawable/sensor_section_bg"
  			android:paddingLeft="10dip"
  			android:paddingRight="4dip">
  			<TextView
  				android:layout_width="0dip"
  				android:layout_height="wrap_content"
  				android:layout_weight="1"
  				android:text="CONDITIONS"
  				android:gravity="center_vertical"
  				android:textStyle="bold"
  				android:textAllCaps="true"
  				android:textSize="12dip"
  				android:letterSpacing="0.06"
  				android:textColor="@color/chrome_section_text"/>
  			<Spinner
  				android:id="@+id/trigger_conditions_op"
  				android:layout_width="wrap_content"
  				android:layout_height="wrap_content"
  				android:minWidth="72dip"
  				android:popupBackground="#FF000000"/>
  		</LinearLayout>
  		<TextView
  			android:id="@+id/trigger_conditions_hint"
  			android:layout_width="match_parent"
  			android:layout_height="wrap_content"
  			android:layout_marginLeft="10dip"
  			android:layout_marginRight="10dip"
  			android:paddingLeft="6dip"
  			android:paddingRight="6dip"
  			android:paddingTop="6dip"
  			android:paddingBottom="6dip"
  			android:textColor="@color/chrome_description"
  			android:textSize="12sp"
  			android:text="No conditions — always runs when the pattern matches."/>
  		<TableLayout
  			android:id="@+id/trigger_conditions_table"
  			android:layout_width="match_parent"
  			android:layout_height="wrap_content"
  			android:layout_marginLeft="10dip"
  			android:layout_marginRight="10dip"
  			android:stretchColumns="0"
  			android:shrinkColumns="0"/>
  		<Button
  			android:id="@+id/trigger_new_condition"
  			android:layout_width="match_parent"
  			android:layout_height="wrap_content"
  			android:layout_marginLeft="10dip"
  			android:layout_marginRight="10dip"
  			android:layout_marginBottom="8dip"
  			android:text="Add Condition"/>
		<TextView android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:minHeight="34dip"
					android:gravity="center_vertical"
					android:paddingLeft="10dip"
					android:paddingRight="10dip"
					android:text="EXECUTE ACTIONS"
					android:layout_marginLeft="10dip"
					android:layout_marginRight="10dip"
					android:background="@drawable/sensor_section_bg"
					android:textAllCaps="true"
					android:textSize="12dip"
					android:letterSpacing="0.06"
					android:textStyle="bold"
					android:textColor="@color/chrome_section_text"/>
  		<LinearLayout
  			android:id="@+id/trigger_action_list"
  			android:layout_width="match_parent"
  			android:layout_height="wrap_content"
  			android:layout_marginLeft="10dip"
  			android:layout_marginRight="10dip"
  			android:paddingBottom="12dip"
  			android:clipChildren="true"
  			android:clipToPadding="true"
  			android:orientation="vertical"/>
  		<!-- paddingBottom: gap after the last Closed box. New Action is
  		     pinned below this ScrollView so a long preview cannot bury it. -->
  	</LinearLayout>
  	
  </ScrollView>

  <Button
  	android:id="@+id/trigger_new_notification"
  	android:layout_width="match_parent"
  	android:layout_height="wrap_content"
  	android:layout_marginLeft="10dip"
  	android:layout_marginRight="10dip"
  	android:layout_marginTop="4dip"
  	android:layout_marginBottom="4dip"
  	android:text="New Action"/>

  <LinearLayout
  	android:id="@+id/editor_button_bar"
  	android:layout_width="match_parent"
  	android:layout_height="wrap_content"
  	android:orientation="horizontal"
  	android:gravity="center"
  	android:background="@color/chrome_title_bar"
  	android:paddingLeft="6dip"
  	android:paddingRight="6dip"
  	android:paddingTop="6dip"
  	android:paddingBottom="6dip">
	  <Button
	    android:layout_width="0dip"
	  	android:layout_height="wrap_content"
	  	android:layout_weight="1"
	  	android:minHeight="44dip"
	  	android:id="@+id/new_trigger_cancel"
	  	android:text="Cancel" />
	  <Button
	  	android:id="@+id/trigger_editor_help_button"
	  	android:layout_width="wrap_content"
	  	android:layout_height="wrap_content"
	  	android:minHeight="44dip"
	  	android:minWidth="52dip"
	  	android:layout_marginLeft="6dip"
	  	android:background="@drawable/editor_more_button_bg"
	  	android:textColor="@color/chrome_chip_text"
	  	android:textSize="16dip"
	  	android:textStyle="bold"
	  	android:text="?" />
	  <Button
	  	android:layout_width="0dip"
	  	android:layout_height="wrap_content"
	  	android:layout_weight="1"
	  	android:minHeight="44dip"
	  	android:layout_marginLeft="6dip"
	  	android:text="Done"
	  	android:id="@+id/trigger_editor_done_button"/>
  </LinearLayout>

</LinearLayout>
