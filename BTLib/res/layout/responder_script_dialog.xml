<?xml version="1.0" encoding="UTF-8"?>

<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/newscriptresponderlayout"
  android:layout_width="wrap_content"
  android:layout_height="wrap_content"
  android:minWidth="300dip"
  android:orientation="vertical">

  <TextView
		android:id="@+id/titlebar"
		android:layout_width="match_parent"
		android:layout_height="42dip"
		android:text="SCRIPT RESPONDER"
		android:textColor="@color/chrome_title_text"
		android:background="@color/chrome_title_bar"
		android:textSize="14dip"
		android:textStyle="bold"
		android:textAllCaps="true"
		android:gravity="center"/>

  <LinearLayout
  	android:layout_width="match_parent"
  	android:layout_height="wrap_content"
  	android:orientation="vertical">
  	<TextView
  		android:id="@+id/action_label"
  		android:layout_width="match_parent"
  		android:layout_height="wrap_content"
  		android:text="Execute Script Function:" />
  	<EditText
  		android:id="@+id/function"
  		android:layout_width="match_parent"
  		android:layout_height="wrap_content"
  		android:singleLine="true"/>
  </LinearLayout>

  <LinearLayout
  	android:layout_width="match_parent"
  	android:layout_height="wrap_content"
  	android:orientation="horizontal">
    <Button
    	android:layout_width="0dip"
  		android:layout_height="wrap_content"
  		android:layout_weight="1"
  		android:id="@+id/cancel"
  		android:text="Cancel" />
    <Button
  		android:layout_width="0dip"
  		android:layout_height="wrap_content"
  		android:layout_weight="1"
  		android:text="Done"
  		android:id="@+id/done"/>
  </LinearLayout>

</LinearLayout>
