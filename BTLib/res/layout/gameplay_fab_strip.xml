<?xml version="1.0" encoding="UTF-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/gameplay_fab_strip"
    android:layout_width="wrap_content"
    android:layout_height="48dp"
    android:layout_gravity="bottom|end"
    android:background="@android:color/transparent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/editor_actions"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <!--
          Undo/redo come first, so the two destructive-looking icons (cancel,
          done) stay where the thumb already knows them. Both start disabled:
          buttonwindow.lua greys them from the size of its own history.
        -->
        <ImageButton
            android:id="@+id/editor_undo"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:alpha="0.35"
            android:background="@android:color/transparent"
            android:contentDescription="Undo layout change"
            android:enabled="false"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_editor_undo" />

        <ImageButton
            android:id="@+id/editor_redo"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:alpha="0.35"
            android:background="@android:color/transparent"
            android:contentDescription="Redo layout change"
            android:enabled="false"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_editor_redo" />

        <ImageButton
            android:id="@+id/editor_settings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="Editor settings"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_editor_settings" />

        <ImageButton
            android:id="@+id/editor_cancel"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="Cancel button layout"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_editor_cancel" />

        <ImageButton
            android:id="@+id/editor_done"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="Save button layout"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_editor_done" />
    </LinearLayout>

    <!--
      ⋮ keeps a backing plate so it stays findable when a floating overlay is
      parked in this corner. The strip's 48dp box is unchanged: the plate is a
      background on the button, not a new wrapper — placeGameplayFabStrip
      rebuilds these params on every input-bar height change, and
      ChromeSmokeTest asserts ⋮'s parent is still the strip itself.
    -->
    <ImageButton
        android:id="@+id/overflow_menu"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/gameplay_overflow_bg"
        android:contentDescription="More options"
        android:padding="10dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_overflow_more" />

    <!--
      Sibling after ⋮, not a FrameLayout wrapper: ChromeSmokeTest asserts
      overflow.getParent() == fabStrip. Negative start margin + clipChildren
      false parks a 12dp disc on the ⋮ face (not past the screen edge).
    -->
    <View
        android:id="@+id/chat_unread_dot"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_gravity="top"
        android:layout_marginStart="-20dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/chat_unread_dot"
        android:clickable="false"
        android:contentDescription="Unread chat"
        android:focusable="false"
        android:importantForAccessibility="yes"
        android:visibility="gone" />

</LinearLayout>
