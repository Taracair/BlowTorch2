<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:id="@+id/options_subdialog_root"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@color/chrome_body"
	android:orientation="vertical">

	<TextView
		android:id="@+id/options_subdialog_title"
		style="@style/BlowTorch.Chrome.Title" />

	<ScrollView
		android:id="@+id/options_subdialog_scroll"
		android:layout_width="match_parent"
		android:layout_height="0dip"
		android:layout_weight="1"
		android:fillViewport="true">

		<LinearLayout
			android:id="@+id/options_subdialog_body"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:padding="12dip" />
	</ScrollView>

	<LinearLayout
		android:id="@+id/options_subdialog_buttons"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:background="@color/chrome_title_bar"
		android:gravity="center"
		android:orientation="horizontal"
		android:paddingLeft="6dip"
		android:paddingRight="6dip"
		android:paddingTop="6dip"
		android:paddingBottom="6dip" />
</LinearLayout>
