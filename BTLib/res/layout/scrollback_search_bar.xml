<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrollback_search_bar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone"
    android:background="@color/chrome_body"
    android:paddingLeft="6dip"
    android:paddingRight="6dip"
    android:paddingTop="6dip"
    android:paddingBottom="6dip"
    android:elevation="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/scrollback_search_query"
            android:layout_width="0dip"
            android:layout_height="40dip"
            android:layout_weight="1"
            android:background="@drawable/editor_search_field_bg"
            android:textColor="@color/chrome_title_text"
            android:textColorHint="@color/chrome_hint"
            android:hint="Search scrollback…"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:singleLine="true"
            android:paddingLeft="10dip"
            android:paddingRight="10dip"
            android:textSize="14sp"
            android:typeface="monospace" />

        <CheckBox
            android:id="@+id/scrollback_search_case"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dip"
            android:text="Aa"
            android:textColor="@color/chrome_title_text"
            android:textSize="12sp"
            android:buttonTint="@color/chrome_accent" />

        <Button
            android:id="@+id/scrollback_search_find"
            style="@style/InputEditToolButton"
            android:layout_marginLeft="2dip"
            android:text="Find" />

        <Button
            android:id="@+id/scrollback_search_close"
            style="@style/InputEditToolButton"
            android:text="✕" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="4dip">

        <Button
            android:id="@+id/scrollback_search_prev"
            style="@style/InputEditToolButton"
            android:minWidth="72dip"
            android:text="◀ Prev" />

        <TextView
            android:id="@+id/scrollback_search_count"
            android:layout_width="0dip"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="0 / 0"
            android:textColor="@color/chrome_title_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/scrollback_search_next"
            style="@style/InputEditToolButton"
            android:minWidth="72dip"
            android:text="Next ▶" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="4dip">

        <CheckBox
            android:id="@+id/scrollback_search_logs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Logs"
            android:textColor="@color/chrome_title_text"
            android:textSize="12sp"
            android:buttonTint="@color/chrome_accent" />

        <EditText
            android:id="@+id/scrollback_search_log_days"
            android:layout_width="48dip"
            android:layout_height="36dip"
            android:layout_marginLeft="6dip"
            android:background="@drawable/editor_search_field_bg"
            android:textColor="@color/chrome_title_text"
            android:textColorHint="@color/chrome_hint"
            android:hint="7"
            android:text="7"
            android:gravity="center"
            android:imeOptions="actionDone"
            android:inputType="number"
            android:maxLength="4"
            android:singleLine="true"
            android:textSize="13sp" />

        <TextView
            android:layout_width="0dip"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="6dip"
            android:text="days (this folder, last N days; 0 = all)"
            android:textColor="@color/chrome_description"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/scrollback_search_preview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="4dip"
        android:paddingBottom="2dip"
        android:textColor="@color/chrome_description"
        android:textSize="12sp"
        android:typeface="monospace"
        android:maxLines="3"
        android:ellipsize="end"
        android:text="Enter a phrase and tap Find. Tick Logs to search /BlowTorch/session_logs/ (last N days, including today). 0 = every file. .search 'logs' still finds the word in the window." />
</LinearLayout>
