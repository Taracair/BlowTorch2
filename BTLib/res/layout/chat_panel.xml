<?xml version="1.0" encoding="utf-8"?>
<!-- Left chat drawer. Hosted on window_container so ⋮ (gameplay_chrome_overlay)
     stays above it. Width is applied in ChatPanelController (~80%). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/chat_panel_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone">

    <View
        android:id="@+id/chat_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Dismiss chat" />

    <LinearLayout
        android:id="@+id/chat_drawer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="#FF1A1A1A"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:id="@+id/chat_title_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@color/extra_text_title_bar"
            android:paddingLeft="4dp"
            android:paddingRight="4dp">

            <TextView
                android:id="@+id/chat_back"
                android:layout_width="36dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="‹"
                android:textColor="@color/extra_text_title_text"
                android:textSize="22sp"
                android:visibility="gone"
                android:contentDescription="Back to thread list" />

            <TextView
                android:id="@+id/chat_title"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:paddingLeft="8dp"
                android:text="Chat"
                android:textColor="@color/extra_text_title_text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/chat_settings_toggle"
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="⚙"
                android:textColor="@color/extra_text_title_text"
                android:textSize="16sp"
                android:contentDescription="Chat settings" />

            <TextView
                android:id="@+id/chat_close"
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="✕"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:background="#44FFFFFF"
                android:contentDescription="Close chat" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/game_chrome_edge" />

        <LinearLayout
            android:id="@+id/chat_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/chat_me_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:paddingTop="6dp"
                android:paddingBottom="2dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="My lines"
                    android:textColor="@color/chrome_description"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/chat_mine_help_button"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="?"
                    android:textColor="@color/chrome_description"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:contentDescription="How to fill My lines" />

                <EditText
                    android:id="@+id/chat_mine_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginLeft="4dp"
                    android:background="@drawable/input_bar_bg"
                    android:hint="your name"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLines="1"
                    android:padding="6dp"
                    android:textColor="@color/chrome_title_text"
                    android:textColorHint="@color/chrome_hint"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/chat_mine_colors"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </LinearLayout>

            <TextView
                android:id="@+id/chat_mine_help"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:paddingBottom="6dp"
                android:text="The name the world prints when you speak. Tap ? for examples."
                android:textColor="@color/chrome_description"
                android:textSize="11sp" />

            <LinearLayout
                android:id="@+id/chat_template_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reply"
                    android:textColor="@color/chrome_description"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/chat_template"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginLeft="8dp"
                    android:background="@drawable/input_bar_bg"
                    android:hint="tell $1 $text"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLines="1"
                    android:padding="6dp"
                    android:textColor="@color/chrome_title_text"
                    android:textColorHint="@color/chrome_hint"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:paddingBottom="6dp"
                android:text="Command sent. $text is the reply box."
                android:textColor="@color/chrome_description"
                android:textSize="11sp" />

            <LinearLayout
                android:id="@+id/chat_date_filter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="6dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/chat_filter_from"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="#332A3A4A"
                    android:gravity="center"
                    android:minHeight="32dp"
                    android:paddingLeft="6dp"
                    android:paddingRight="6dp"
                    android:text="From"
                    android:textColor="#9EC5FF"
                    android:textSize="12sp"
                    android:contentDescription="Filter from date" />

                <TextView
                    android:id="@+id/chat_filter_to"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6dp"
                    android:layout_weight="1"
                    android:background="#332A3A4A"
                    android:gravity="center"
                    android:minHeight="32dp"
                    android:paddingLeft="6dp"
                    android:paddingRight="6dp"
                    android:text="To"
                    android:textColor="#9EC5FF"
                    android:textSize="12sp"
                    android:contentDescription="Filter to date" />

                <TextView
                    android:id="@+id/chat_filter_7d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6dp"
                    android:background="#332A3A4A"
                    android:gravity="center"
                    android:minHeight="32dp"
                    android:minWidth="36dp"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:text="7d"
                    android:textColor="#9EC5FF"
                    android:textSize="12sp"
                    android:contentDescription="Last 7 days" />

                <TextView
                    android:id="@+id/chat_filter_all"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6dp"
                    android:background="#332A3A4A"
                    android:gravity="center"
                    android:minHeight="32dp"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:text="All"
                    android:textColor="#9EC5FF"
                    android:textSize="12sp"
                    android:contentDescription="Clear date filter" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/chat_settings_save"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="#332A3A4A"
                    android:gravity="center"
                    android:minHeight="32dp"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:text="Save"
                    android:textColor="#9EC5FF"
                    android:textSize="12sp"
                    android:contentDescription="Save chat settings" />

                <TextView
                    android:id="@+id/chat_thread_delete"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:layout_weight="1"
                    android:background="#334A2A2A"
                    android:gravity="center"
                    android:minHeight="32dp"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:text="Delete"
                    android:textColor="#FFB0B0"
                    android:textSize="12sp"
                    android:contentDescription="Delete conversation" />
            </LinearLayout>

            <TextView
                android:id="@+id/chat_orphan_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:paddingBottom="8dp"
                android:text="No trigger uses this exact thread name. You can delete the stored conversation."
                android:textColor="@color/chrome_description"
                android:textSize="11sp"
                android:visibility="gone" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/game_chrome_edge" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/chat_inbox"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <EditText
                android:id="@+id/chat_search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:background="@drawable/input_bar_bg"
                android:hint="Search threads"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:padding="8dp"
                android:textColor="@color/chrome_title_text"
                android:textColorHint="@color/chrome_hint"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/chat_inbox_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="No threads yet. A Send to thread trigger action collects chat here."
                android:textColor="@color/chrome_description"
                android:textSize="13sp" />

            <ScrollView
                android:id="@+id/chat_thread_scroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true">

                <LinearLayout
                    android:id="@+id/chat_thread_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/chat_thread"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/chat_thread_filter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:paddingTop="6dp"
                android:paddingBottom="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/chat_thread_search"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/input_bar_bg"
                        android:hint="Find in this thread"
                        android:imeOptions="actionSearch"
                        android:importantForAutofill="no"
                        android:inputType="text"
                        android:maxLines="1"
                        android:padding="8dp"
                        android:textColor="@color/chrome_title_text"
                        android:textColorHint="@color/chrome_hint"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:id="@+id/chat_find_nav"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/chat_find_prev"
                            android:layout_width="28dp"
                            android:layout_height="32dp"
                            android:clickable="true"
                            android:contentDescription="Previous match"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="‹"
                            android:textColor="#80FFFFFF"
                            android:textSize="18sp" />

                        <TextView
                            android:id="@+id/chat_find_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:minWidth="28dp"
                            android:paddingLeft="2dp"
                            android:paddingRight="2dp"
                            android:text="0/0"
                            android:textColor="#80FFFFFF"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/chat_find_next"
                            android:layout_width="28dp"
                            android:layout_height="32dp"
                            android:clickable="true"
                            android:contentDescription="Next match"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="›"
                            android:textColor="#80FFFFFF"
                            android:textSize="18sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/chat_thread_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:paddingBottom="8dp"
                android:text="No matching messages."
                android:textColor="@color/chrome_description"
                android:textSize="13sp"
                android:visibility="gone" />

            <ScrollView
                android:id="@+id/chat_message_scroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true">

                <LinearLayout
                    android:id="@+id/chat_message_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:paddingBottom="8dp" />
            </ScrollView>

            <LinearLayout
                android:id="@+id/chat_reply_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:paddingTop="8dp"
                android:paddingBottom="10dp">

                <EditText
                    android:id="@+id/chat_reply"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/input_bar_bg"
                    android:hint="Reply"
                    android:imeOptions="actionSend"
                    android:importantForAutofill="no"
                    android:inputType="textMultiLine"
                    android:maxLines="4"
                    android:minHeight="44dp"
                    android:padding="8dp"
                    android:textColor="@color/game_input_text"
                    android:textColorHint="@color/chrome_hint"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/chat_send"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:background="#FF1B6B66"
                    android:gravity="center"
                    android:minHeight="44dp"
                    android:minWidth="64dp"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:text="Send"
                    android:textColor="#FFFFFFFF"
                    android:textSize="14sp"
                    android:contentDescription="Send reply" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
