<?xml version="1.0" encoding="utf-8"?>
<!-- Left chat drawer. Hosted on window_container so ⋮ (gameplay_chrome_overlay)
     stays above it. Width is applied in ChatPanelController (~80%). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/chat_panel_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone">

    <View
        android:id="@+id/chat_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Dismiss chat" />

    <LinearLayout
        android:id="@+id/chat_drawer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="#FF1A1A1A"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:id="@+id/chat_title_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@color/extra_text_title_bar"
            android:paddingLeft="4dp"
            android:paddingRight="4dp">

            <TextView
                android:id="@+id/chat_back"
                android:layout_width="36dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="‹"
                android:textColor="@color/extra_text_title_text"
                android:textSize="22sp"
                android:visibility="gone"
                android:contentDescription="Back to thread list" />

            <TextView
                android:id="@+id/chat_title"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:paddingLeft="8dp"
                android:text="Chat"
                android:textColor="@color/extra_text_title_text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/chat_close"
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="✕"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:background="#44FFFFFF"
                android:contentDescription="Close chat" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/game_chrome_edge" />

        <LinearLayout
            android:id="@+id/chat_inbox"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <EditText
                android:id="@+id/chat_search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:background="@drawable/input_bar_bg"
                android:hint="Search threads"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:padding="8dp"
                android:textColor="@color/chrome_title_text"
                android:textColorHint="@color/chrome_hint"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/chat_inbox_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="No threads yet. A Send to thread trigger action collects chat here."
                android:textColor="@color/chrome_description"
                android:textSize="13sp" />

            <ScrollView
                android:id="@+id/chat_thread_scroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true">

                <LinearLayout
                    android:id="@+id/chat_thread_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/chat_thread"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/chat_template_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <EditText
                    android:id="@+id/chat_template"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/input_bar_bg"
                    android:hint="tell $1 $text"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLines="1"
                    android:padding="6dp"
                    android:textColor="@color/chrome_title_text"
                    android:textColorHint="@color/chrome_hint"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/chat_template_set"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:background="#332A3A4A"
                    android:gravity="center"
                    android:minHeight="32dp"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:text="Set"
                    android:textColor="#9EC5FF"
                    android:textSize="12sp"
                    android:contentDescription="Save reply template" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/chat_message_scroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true">

                <LinearLayout
                    android:id="@+id/chat_message_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:paddingBottom="8dp" />
            </ScrollView>

            <LinearLayout
                android:id="@+id/chat_reply_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="horizontal"
                android:padding="8dp">

                <EditText
                    android:id="@+id/chat_reply"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/input_bar_bg"
                    android:hint="Reply"
                    android:imeOptions="actionSend"
                    android:importantForAutofill="no"
                    android:inputType="textMultiLine"
                    android:maxLines="4"
                    android:minHeight="40dp"
                    android:padding="8dp"
                    android:textColor="@color/game_input_text"
                    android:textColorHint="@color/chrome_hint"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/chat_send"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:background="#332A3A4A"
                    android:gravity="center"
                    android:minHeight="40dp"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:text="Send"
                    android:textColor="#9EC5FF"
                    android:textSize="14sp"
                    android:contentDescription="Send reply" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
