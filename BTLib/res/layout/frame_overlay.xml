<?xml version="1.0" encoding="utf-8"?>
<!--
  A mudstd.frame image frame. Same two shapes as an extra text window:
  drawer_top (content + bottom grab edge) or float (title + content + resize).
  The content is a picture rather than a text Window, so this is its own layout
  with its own ids — sharing extra_text_overlay would mean one file where a
  change for a frame could quietly move a text window.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/frame_overlay_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FF1A1A1A"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/frame_body"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Float only: title / drag / close. Drawer keeps this GONE.
             Title bar uses the extra-text named colours so a frame over black
             game text still reads as a grab handle, not one unbroken rectangle. -->
        <LinearLayout
            android:id="@+id/frame_title_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="36dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@color/extra_text_title_bar"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/frame_drag_handle"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingLeft="4dp"
                android:paddingRight="6dp"
                android:text="☰"
                android:textColor="#9999FF"
                android:textSize="16sp"
                android:contentDescription="Drag frame" />

            <TextView
                android:id="@+id/frame_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:text="Frame"
                android:textColor="@color/extra_text_title_text"
                android:textSize="13sp" />

            <include
                android:id="@+id/frame_close"
                layout="@layout/window_close_button"
                android:layout_width="32dp"
                android:layout_height="32dp" />
        </LinearLayout>

        <View
            android:id="@+id/frame_accent"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/game_chrome_edge"
            android:visibility="gone" />

        <!-- The picture fills what is left. -->
        <FrameLayout
            android:id="@+id/frame_content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/frame_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:adjustViewBounds="false"
                android:scaleType="fitCenter"
                android:contentDescription="Picture sent by the server" />

            <!-- Says why there is no picture: loading, or what went wrong. -->
            <TextView
                android:id="@+id/frame_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="8dp"
                android:textColor="#CCCCCC"
                android:textSize="12sp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- Drawer resize strip: overlays the bottom, does not eat layout height. -->
    <FrameLayout
        android:id="@+id/frame_edge_bottom"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_gravity="bottom"
        android:background="@android:color/transparent"
        android:visibility="gone"
        android:contentDescription="Resize frame drawer">
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_gravity="bottom"
            android:background="@color/game_chrome_edge" />
    </FrameLayout>

    <!-- Drawer only: the drawer has no title bar, so its close lives here. -->
    <ImageButton
        android:id="@+id/frame_drawer_close"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="top|end"
        android:padding="6dp"
        android:background="#66000000"
        android:src="@drawable/ic_window_close"
        android:contentDescription="Close frame"
        android:visibility="gone" />

    <TextView
        android:id="@+id/frame_resize_handle"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="bottom|end"
        android:gravity="bottom|end"
        android:paddingBottom="2dp"
        android:paddingRight="4dp"
        android:paddingEnd="4dp"
        android:text="◢"
        android:textColor="#9999FF"
        android:textSize="22sp"
        android:background="#66000000"
        android:visibility="gone"
        android:elevation="4dp"
        android:contentDescription="Resize floating frame" />
</FrameLayout>
