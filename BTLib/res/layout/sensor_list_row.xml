<?xml version="1.0" encoding="UTF-8"?>

<!--
  One reading in the Sensors list.

  Built like editor_selection_list_row: name on top, one line under it, action
  icons centred on the right, the same colours and the same row selector. Play
  is Test and the pencil is the trigger editor, so they read the same here as
  they do on the Alias / Trigger / Timer lists.

  Both icons stay on every row and Test simply dims where there is nothing to
  fire — the button vanishing on fifteen of sixteen rows read as a missing
  feature. The left edge lights up only where something answers the reading,
  which is the one thing this list is scanned for.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:orientation="vertical">

	<RelativeLayout
		android:id="@+id/row"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:minHeight="52dip"
		android:paddingTop="6dip"
		android:paddingBottom="6dip"
		android:paddingRight="6dip"
		android:background="@drawable/editor_row_selector">

		<View
			android:id="@+id/accent"
			android:layout_width="3dip"
			android:layout_height="match_parent"
			android:layout_alignParentLeft="true"
			android:layout_alignParentTop="true"
			android:layout_alignParentBottom="true"
			android:background="#00000000"/>

		<LinearLayout
			android:id="@+id/toolbarholder"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_alignParentTop="true"
			android:layout_alignParentBottom="true"
			android:layout_alignParentRight="true"
			android:gravity="center_vertical|right"
			android:orientation="horizontal"
			android:paddingLeft="6dip">

			<ImageButton
				android:id="@+id/test"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:padding="6dip"
				android:background="@android:color/transparent"
				android:focusable="false"
				android:focusableInTouchMode="false"
				android:contentDescription="Test"
				android:src="@drawable/ic_row_play"/>

			<ImageButton
				android:id="@+id/edit"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:padding="6dip"
				android:background="@android:color/transparent"
				android:focusable="false"
				android:focusableInTouchMode="false"
				android:contentDescription="Set up"
				android:src="@drawable/ic_row_edit"/>
		</LinearLayout>

		<TextView
			android:id="@+id/label"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_alignParentTop="true"
			android:layout_toRightOf="@id/accent"
			android:layout_toLeftOf="@id/toolbarholder"
			android:layout_marginLeft="10dip"
			android:focusable="false"
			android:focusableInTouchMode="false"
			android:textColor="#FFF2F4F6"
			android:textSize="16dip"
			android:textStyle="bold"
			android:lines="1"
			android:ellipsize="end"
			android:text="Shake the phone"/>

		<TextView
			android:id="@+id/status"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_below="@id/label"
			android:layout_toRightOf="@id/accent"
			android:layout_toLeftOf="@id/toolbarholder"
			android:layout_marginLeft="10dip"
			android:paddingTop="1dip"
			android:paddingRight="6dip"
			android:focusable="false"
			android:focusableInTouchMode="false"
			android:textColor="#FF9AA3AD"
			android:textSize="12dip"
			android:maxLines="2"
			android:ellipsize="end"
			android:text="Not set up"/>
	</RelativeLayout>

	<View
		android:layout_width="match_parent"
		android:layout_height="1dip"
		android:background="#FF23262B"/>
</LinearLayout>
