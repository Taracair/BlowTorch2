<?xml version="1.0" encoding="utf-8"?>
<!--
  Default square backing for a floating button copy. Round / optional frame are
  drawn in FloatingButtonView from the button's own colours; this is only a
  fallback plate when the view has not yet applied custom paint.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#D216161C" />
    <stroke
        android:width="1dp"
        android:color="@color/game_chrome_edge" />
</shape>
