<?xml version="1.0" encoding="utf-8"?>
<!--
  A heading strip in the Sensors list. One step lighter than the rows, with a
  hairline along the top and the bottom, so a group reads as a block rather than
  as a slightly bluer row. A gap alone was not enough to separate them.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF2A2F36"/>
        </shape>
    </item>
    <item android:top="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#FF1B1F25"/>
        </shape>
    </item>
</layer-list>
