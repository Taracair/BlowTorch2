<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded and slightly lighter than the game background, with a hairline
     edge. A square black block over the game text reads as a rendering fault;
     a rounded plate reads as something floating on purpose. The alpha is set
     in code from .complete opacity, on this drawable only, so the words on top
     of it stay fully opaque. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FF1A1D21" />
    <corners android:radius="10dp" />
    <stroke android:width="1dp" android:color="#33FFFFFF" />
</shape>
