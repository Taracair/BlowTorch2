<?xml version="1.0" encoding="UTF-8"?>

<!-- Family A floating card: same chrome as EditorHelp / Sensor Test. -->
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/newnotificationlayout"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:background="@color/chrome_body"
  android:orientation="vertical">

  <TextView
		android:id="@+id/titlebar"
		style="@style/BlowTorch.Chrome.Title"
		android:text="NOTIFICATION RESPONDER"/>

  <ScrollView
  	android:id="@+id/trigger_notification_responder_scroll_container"
  	android:layout_width="match_parent"
  	android:layout_height="0dip"
  	android:layout_weight="1"
  	android:fillViewport="true">
  	<LinearLayout
  		android:layout_width="match_parent"
  		android:layout_height="wrap_content"
  		android:orientation="vertical"
  		android:paddingLeft="12dip"
  		android:paddingRight="12dip"
  		android:paddingTop="8dip"
  		android:paddingBottom="8dip">

  		<TableLayout
  			android:layout_width="match_parent"
  			android:layout_height="wrap_content"
  			android:stretchColumns="1"
  			android:shrinkColumns="1">
  			<TableRow>
  				<TextView
  					android:text="Title:"
  					android:textColor="@color/chrome_title_text"
  					android:paddingTop="8dip"
  					android:paddingRight="8dip"/>
  				<EditText
  					android:id="@+id/responder_notification_title"
  					android:hint=""
  					android:singleLine="true"
  					android:inputType="text"
  					android:textColor="@color/chrome_title_text"/>
  			</TableRow>
  			<TableRow>
  				<TextView
  					android:text="Message:"
  					android:textColor="@color/chrome_title_text"
  					android:paddingTop="8dip"
  					android:paddingRight="8dip"/>
  				<EditText
  					android:id="@+id/responder_notification_extra"
  					android:hint=""
  					android:singleLine="true"
  					android:inputType="text"
  					android:textColor="@color/chrome_title_text"/>
  			</TableRow>
  		</TableLayout>

  		<LinearLayout
  			android:layout_width="match_parent"
  			android:layout_height="wrap_content"
  			android:orientation="vertical"
  			android:layout_marginTop="10dip"
  			android:background="@drawable/sensor_section_bg"
  			android:paddingTop="4dip"
  			android:paddingBottom="4dip">

  			<LinearLayout
  				android:layout_width="match_parent"
  				android:layout_height="wrap_content"
  				android:orientation="horizontal"
  				android:gravity="center_vertical"
  				android:paddingLeft="10dip"
  				android:paddingRight="10dip"
  				android:minHeight="48dip">
  				<LinearLayout
  					android:layout_width="0dip"
  					android:layout_height="wrap_content"
  					android:layout_weight="1"
  					android:orientation="vertical">
  					<TextView
  						android:layout_width="match_parent"
  						android:layout_height="wrap_content"
  						android:text="Play sound?"
  						android:textColor="@color/chrome_title_text"
  						android:textSize="15sp"/>
  					<TextView
  						android:id="@+id/responder_notification_sound_extra"
  						android:layout_width="match_parent"
  						android:layout_height="wrap_content"
  						android:text="Currently using default sound."
  						android:textColor="@color/chrome_description"
  						android:textSize="12sp"/>
  				</LinearLayout>
  				<CheckBox
  					android:id="@+id/responder_notification_sound_check"
  					android:layout_width="wrap_content"
  					android:layout_height="wrap_content"
  					android:checked="false"/>
  			</LinearLayout>

  			<LinearLayout
  				android:layout_width="match_parent"
  				android:layout_height="wrap_content"
  				android:orientation="horizontal"
  				android:gravity="center_vertical"
  				android:paddingLeft="10dip"
  				android:paddingRight="10dip"
  				android:minHeight="48dip">
  				<LinearLayout
  					android:layout_width="0dip"
  					android:layout_height="wrap_content"
  					android:layout_weight="1"
  					android:orientation="vertical">
  					<TextView
  						android:layout_width="match_parent"
  						android:layout_height="wrap_content"
  						android:text="Vibrate?"
  						android:textColor="@color/chrome_title_text"
  						android:textSize="15sp"/>
  					<TextView
  						android:id="@+id/responder_notification_vibrate_extra"
  						android:layout_width="match_parent"
  						android:layout_height="wrap_content"
  						android:text="Currently using: default"
  						android:textColor="@color/chrome_description"
  						android:textSize="12sp"/>
  				</LinearLayout>
  				<CheckBox
  					android:id="@+id/responder_notification_vibrate_check"
  					android:layout_width="wrap_content"
  					android:layout_height="wrap_content"
  					android:checked="false"/>
  			</LinearLayout>

  			<LinearLayout
  				android:layout_width="match_parent"
  				android:layout_height="wrap_content"
  				android:orientation="horizontal"
  				android:gravity="center_vertical"
  				android:paddingLeft="10dip"
  				android:paddingRight="10dip"
  				android:minHeight="48dip">
  				<LinearLayout
  					android:layout_width="0dip"
  					android:layout_height="wrap_content"
  					android:layout_weight="1"
  					android:orientation="vertical">
  					<TextView
  						android:layout_width="match_parent"
  						android:layout_height="wrap_content"
  						android:text="Show lights?"
  						android:textColor="@color/chrome_title_text"
  						android:textSize="15sp"/>
  					<TextView
  						android:id="@+id/responder_notification_lights_extra"
  						android:layout_width="match_parent"
  						android:layout_height="wrap_content"
  						android:text="Currently disabled."
  						android:textColor="@color/chrome_description"
  						android:textSize="12sp"/>
  				</LinearLayout>
  				<CheckBox
  					android:id="@+id/responder_notification_lights_check"
  					android:layout_width="wrap_content"
  					android:layout_height="wrap_content"
  					android:checked="false"/>
  			</LinearLayout>

  			<LinearLayout
  				android:layout_width="match_parent"
  				android:layout_height="wrap_content"
  				android:orientation="horizontal"
  				android:gravity="center_vertical"
  				android:paddingLeft="10dip"
  				android:paddingRight="10dip"
  				android:minHeight="48dip">
  				<LinearLayout
  					android:layout_width="0dip"
  					android:layout_height="wrap_content"
  					android:layout_weight="1"
  					android:orientation="vertical">
  					<TextView
  						android:layout_width="match_parent"
  						android:layout_height="wrap_content"
  						android:text="Spawn new?"
  						android:textColor="@color/chrome_title_text"
  						android:textSize="15sp"/>
  					<TextView
  						android:layout_width="match_parent"
  						android:layout_height="wrap_content"
  						android:text="A new notification every time, instead of replacing the last."
  						android:textColor="@color/chrome_description"
  						android:textSize="12sp"/>
  				</LinearLayout>
  				<CheckBox
  					android:id="@+id/responder_notification_spawnnew_check"
  					android:layout_width="wrap_content"
  					android:layout_height="wrap_content"
  					android:checked="false"/>
  			</LinearLayout>
  		</LinearLayout>
  	</LinearLayout>
  </ScrollView>

  <LinearLayout
  	android:layout_width="match_parent"
  	android:layout_height="wrap_content"
  	android:orientation="horizontal"
  	android:gravity="center"
  	android:background="@color/chrome_title_bar"
  	android:paddingLeft="6dip"
  	android:paddingRight="6dip"
  	android:paddingTop="6dip"
  	android:paddingBottom="6dip">
	  <Button
	    android:id="@+id/responder_notification_cancel"
	    android:layout_width="0dip"
	  	android:layout_height="wrap_content"
	  	android:layout_weight="1"
	  	android:minHeight="44dip"
	  	android:text="Cancel" />
	  <Button
	  	android:id="@+id/responder_notification_done_button"
	  	android:layout_width="0dip"
	  	android:layout_height="wrap_content"
	  	android:layout_weight="1"
	  	android:minHeight="44dip"
	  	android:layout_marginLeft="6dip"
	  	android:text="Done"/>
  </LinearLayout>

</LinearLayout>
