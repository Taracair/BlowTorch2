<?xml version='1.0' encoding='UTF-8' standalone='yes' ?>
<blowtorch xmlversion="2">
  <window lineSize="20" spaceExtra="2" maxLines="300" fontName="monospace" fontPath="none" useExtractUI="false" useSuggest="false" keepLast="false" backspaceBugFix="false" launchEditor="true" disableColor="false" hapticFeedBackOnModify="auto" hapticFeedBackOnPress="auto" hapticFeedBackOnFlip="none" encoding="UTF-8" keepScreenOn="true" fullScreen="true" roundButtons="true" orientation="0" breakAmount="0" wordWrap="true" removeExtraColor="true" debugTelnet="false" wrapMode="1" hyperLinkMode="highlight_color_bland_only" hyperLinkColor="ff66ccff" hyperLinkEnabled="true" id="6666"/>
  <windows>
    <window name="mainDisplay" id="6666">
      <layoutGroup target="normal">
      	<layout orientation="landscape" above="10" alignParentLeft="true" width="fill_parent" height="fill_parent" />
        <layout orientation="portrait" above="10" alignParentLeft="true" width="fill_parent" height="fill_parent" />
      </layoutGroup>
      <options/>
    </window>
  </windows>
  
  <service processSemi="true" throttle="false" processPeriod="true" keepWifiActive="true" localEcho="true" vibrateOnBell="true" notifyOnBell="false" displayOnBell="false" />
  <aliases/>
  <directions>
    <entry dir="w" cmd="w" rev="e" />
    <entry dir="e" cmd="e" rev="w" />
    <entry dir="s" cmd="s" rev="n" />
    <entry dir="n" cmd="n" rev="s" />
    <entry dir="l" cmd="se" rev="nw" />
    <entry dir="j" cmd="ne" rev="sw" />
    <entry dir="k" cmd="sw" rev="ne" />
    <entry dir="h" cmd="nw" rev="se" />
  </directions>
  <!-- Legacy top-level buttonsets (Java HyperSAXParser). Gestures are not parsed here; see button_window plugin below. -->
  <buttonsets>
    <buttonset setName="default" buttonWidth="42" buttonHeight="42" labelSize="12">
    </buttonset>
    <buttonset setName="tutorial" buttonWidth="42" buttonHeight="42" labelSize="12">
      <button xPos="23" yPos="23" label="START" command=".tutorial start" moveMethod="2" labelSize="12" />
      <button xPos="68" yPos="23" label="TOPICS" command=".tutorial topics" moveMethod="2" labelSize="12" />
      <button xPos="113" yPos="23" label="SWIPE" command=".tutorial buttons_swipe" moveMethod="2" labelSize="12" />
      <button xPos="23" yPos="68" label="HOLD" command=".tutorial buttons_hold" moveMethod="2" labelSize="12" />
      <button xPos="68" yPos="68" label="ACC" command=".tutorial buttons_accordion" moveMethod="2" labelSize="12" />
      <button xPos="113" yPos="68" label="N" command="north" moveMethod="2" labelSize="14" />
      <button xPos="23" yPos="113" label="W" command="west" moveMethod="2" labelSize="14" />
      <button xPos="68" yPos="113" label="S" command="south" moveMethod="2" labelSize="14" />
      <button xPos="113" yPos="113" label="E" command="east" moveMethod="2" labelSize="14" />
      <button xPos="23" yPos="158" label="LOOK" command="look" moveMethod="2" labelSize="12" />
      <button xPos="68" yPos="158" label="DEF" command=".loadset default" moveMethod="2" labelSize="12" />
      <button xPos="113" yPos="158" label="CLEAR" command=".clearbuttons" moveMethod="0" labelSize="12" />
    </buttonset>
    <selectedset>default</selectedset>
  </buttonsets>
  <triggers />
  <timers />
  <plugins>
  	 <plugin name="button_window" id="10">
  	 	<windows>
  	 		<window name="button_window" id="10203" script="buttonwindow">
  	 			<layoutGroup target="normal">
  	 				<layout orientation="landscape" height="fill_parent" width="fill_parent" above="40"/>
  	 				<layout orientation="portrait" height="fill_parent" width="fill_parent" above="40"/>
  	 			</layoutGroup>
  	 		</window>
  	 	</windows>
  	 	<options title="Button" summary="Haptic feedback, roundess and other button options.">
  	 		<boolean title="Show gesture hints" key="show_gesture_hints" summary="Draw swipe arrows, hold (H), and accordion chevrons on buttons.">true</boolean>
  	 		<boolean title="Show swipe direction arrow" key="show_swipe_preview" summary="Draw the arrow across a button while you drag it. The command callout above the button shows either way.">true</boolean>
  	 		<boolean title="Offer button layout wizard" key="layout_wizard_pending" summary="Show the pack picker once after connect on a new profile. Finish, skip, or start clean to clear it. Re-enable anytime, or use Options → Button → Load button set from wizard.">true</boolean>
  	 		<callback title="Load button set from wizard" key="layout_wizard_open" summary="Pick templates or start with no buttons. Set names, size, alignment, and colors. Does not remove other button sets.">showLayoutWizardCmd</callback>
  	 		<list title="Button size" key="layout_size_preset" summary="Size of the tiles in the current button set. Changing this resizes the set on screen and becomes the wizard's default.">
  	 			<value>1</value>
  	 			<item>Compact</item>
  	 			<item>Comfortable</item>
  	 			<item>Large</item>
  	 			<item>Extra large</item>
  	 			<item>Fit to screen</item>
  	 		</list>
  	 		<list title="Layout template" key="layout_pack" summary="Which template the wizard offers first. Changing it here does not install anything - pick names and press Apply in the wizard.">
  	 			<value>0</value>
  	 			<item>Compass</item>
  	 			<item>Newbie</item>
  	 			<item>Combat</item>
  	 			<item>Explorer</item>
  	 			<item>Social</item>
  	 		</list>
  	 		<integer title="Button roundness" key="roundess" summary="Radius of button corners.">6</integer>
  	 		<list title="Haptic feedback on editor launch." key="haptic_edit" summary="Perform haptic feedback when the editor is opened.">
  	 			<value>0</value>
  	 			<item>Auto. Obey System Setting</item>
  	 			<item>Always. Override System Setting</item>
  	 			<item>Off</item>
  	 		</list>
  	 		<list title="Haptic feedback on press." key="haptic_press" summary="Perform haptic feedback when pressed.">
  	 			<value>0</value>
  	 			<item>Auto. Obey System Setting</item>
  	 			<item>Always. Override System Setting</item>
  	 			<item>Off</item>
  	 		</list>
  	 		<list title="Haptic feedback on flip." key="haptic_flip" summary="Perform Haptic feedback when flipped (swipe action).">
  	 			<value>0</value>
  	 			<item>Auto. Obey System Setting</item>
  	 			<item>Always. Override System Setting</item>
  	 			<item>Off</item>
  	 		</list>
  	 	</options>
		<script name="bootstrap" execute="true">
		<![CDATA[
			require("buttonserver")
		]]>
		</script>
		<script name="buttonwindow">
			<![CDATA[
			require("buttonwindow")
		]]>
  		</script>
  		<!--
  		  Fresh MUD: empty default set. The layout wizard offers packs or
  		  start-clean; Starter Tutorial still uses the separate tutorial set.
  		-->
   		<buttonsets>
   			<buttonset name="default" setName="default" width="42" height="42" labelSize="12" gridXwidth="45" gridYwidth="45">
   			</buttonset>
   			<buttonset name="tutorial" setName="tutorial" width="42" height="42" labelSize="12" gridXwidth="45" gridYwidth="45">
     			<button x="23" y="23" label="PREV" command=".tutorial prev" labelSize="11" />
     			<button x="68" y="23" label="NEXT" command=".tutorial next" labelSize="11" />
     			<button x="113" y="23" label="TOPICS" command=".tutorial topics" labelSize="10" />
     			<button x="23" y="68" label="START" command=".tutorial start" labelSize="11" />
     			<button x="68" y="68" label="SWIPE" command=".tutorial buttons_swipe" labelSize="11"
     				swipeUpCommand=".note Swipe UP teaches a directional gesture."
     				swipeDownCommand=".note Swipe DOWN teaches a directional gesture."
     				swipeLeftCommand=".note Swipe LEFT teaches a directional gesture."
     				swipeRightCommand=".note Swipe RIGHT teaches a directional gesture." />
     			<button x="113" y="68" label="HOLD" command=".tutorial buttons_hold" labelSize="11"
     				holdCommand=".note Hold fired: secondary command." />
     			<button x="23" y="113" label="N" command="north" labelSize="14"
     				holdCommand=".note Hold on movement buttons also teaches HOLD."
     				swipeUpCommand=".tutorial buttons_swipe" />
     			<button x="68" y="113" label="S" command="south" labelSize="14"
     				holdCommand=".note Hold on movement buttons also teaches HOLD."
     				swipeDownCommand=".tutorial buttons_swipe" />
     			<button x="113" y="113" label="E" command="east" labelSize="14"
     				holdCommand=".note Hold on movement buttons also teaches HOLD."
     				swipeRightCommand=".tutorial buttons_swipe" />
     			<button x="23" y="158" label="W" command="west" labelSize="14"
     				holdCommand=".note Hold on movement buttons also teaches HOLD."
     				swipeLeftCommand=".tutorial buttons_swipe" />
     			<button x="68" y="158" label="LOOK" command="look" labelSize="11" />
     			<button x="113" y="158" label="DEF" command=".loadset default" labelSize="11" />
     			<button x="23" y="203" label="ACC" command=".tutorial buttons_accordion" labelSize="11" />
     			<button x="68" y="203" label="CLEAR" command=".clearbuttons" labelSize="11" />
</buttonset>
			<selected>default</selected>
  		</buttonsets>
	</plugin>
	<plugin name="starter_tutorial" id="20">
		<author>BlowTorch</author>
		<description>Interactive English starter guide for new players. Disable via Options when done.</description>
		<version>1.0</version>
		<options title="Starter Tutorial" summary="Onboarding tips for new players.">
			<boolean title="Show welcome on connect" key="show_on_connect" summary="Print a short welcome tip when connecting to a normal MUD (the Starter Tutorial launcher entry always opens the full guide).">false</boolean>
			<boolean title="Tips while playing?" key="tips_while_playing" summary="When you type a .command on a real MUD, print a short reminder of what it does. Off until you ask (.tips on).">false</boolean>
		</options>
		<script name="bootstrap" execute="true"><![CDATA[
			require("startertutorial")
		]]></script>
	</plugin>
  </plugins>
</blowtorch>
