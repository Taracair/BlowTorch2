<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.VIBRATE"/>
	<uses-permission android:name="android.permission.INTERNET"/>
	<uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
	<uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
	<uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
	<uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
		tools:ignore="ScopedStorage" />
	<uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
	<uses-permission android:name="android.permission.WAKE_LOCK" />
	<uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
	<uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
	<!--
	  Floating buttons only. A view inside our own window cannot be drawn over the
	  soft keyboard - the window manager stacks the IME above every application
	  window - so a button that sits on top of the keys has to live in a
	  TYPE_APPLICATION_OVERLAY window, and that needs this.

	  Asked for at the moment a player turns a button into a floating one, never
	  at startup, and refusing it costs only the over-the-keyboard placement.
	-->
	<uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
	<!--
	  Package visibility, needed since Android 11. Without this the speech engine
	  is invisible to us and TextToSpeech init returns ERROR with nothing but an
	  "AppsFilter ... BLOCKED" line in logcat to say why. Measured on the
	  maintainer's phone: the engine (app.grapheneos.speechservices) was
	  installed and set as the default, and we still could not bind it.

	  It grants nothing beyond being able to see engines that answer the standard
	  TTS intent, which is exactly what the Speak trigger action needs.
	-->
	<queries>
		<intent>
			<action android:name="android.intent.action.TTS_SERVICE" />
		</intent>
	</queries>
    <application tools:replace="android:theme,android:label" android:icon="@drawable/blowtorch_logo3" android:label="${appLabel}" android:allowBackup="false" android:process="${appProcess}" android:hardwareAccelerated="true" android:theme="@style/Theme.AppCompat.Dark.NoActionBar" android:pageSizeCompat="enabled" android:usesCleartextTraffic="true">
	<meta-data android:value="304" android:name="BLOWTORCH_LUA_LIBS_VERSION"/>
        <!--
          FreeLauncher stays the home screen entry so a pinned app icon keeps
          resolving to the same component. World pins must not use this
          component: MAIN/LAUNCHER drops extras, and RESET_TASK on the same
          task shows the server list when the MUD is not already running.
          Old pins that still name FreeLauncher keep working via the
          LAUNCH_WORLD filter; new pins target WorldLaunchActivity.
          BlowTorch.Invisible gives both trampolines no window to draw.
        -->
    	<activity android:name="com.resurrection.blowtorch2.FreeLauncher"
    	          android:label="${appLabel}"
    	          android:theme="@style/BlowTorch.Invisible"
    	          android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.resurrection.blowtorch2.LAUNCH_WORLD" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="blowtorch" android:host="world" />
            </intent-filter>
        </activity>
        <activity android:name="com.resurrection.blowtorch2.lib.launcher.WorldLaunchActivity"
                  android:theme="@style/BlowTorch.Invisible"
                  android:exported="true"
                  android:taskAffinity="${applicationId}.worldlaunch"
                  android:noHistory="true">
            <intent-filter>
                <action android:name="com.resurrection.blowtorch2.LAUNCH_WORLD" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="blowtorch" android:host="world" />
            </intent-filter>
        </activity>
        <activity android:name="com.resurrection.blowtorch2.lib.launcher.Launcher"
                  android:label="${appLabel}"
                  android:exported="false">
        </activity>
        <activity android:name="com.resurrection.blowtorch2.lib.window.MainWindow"
        		  android:theme="@style/BlowTorch.GameWindow"
        		  android:windowSoftInputMode="adjustNothing|stateHidden"
        		  android:label="${appLabel}"
        		  tools:replace="android:label"
				  android:configChanges="orientation|keyboard|keyboardHidden|screenLayout|screenSize"
        		  android:launchMode = "singleTask"
        		  android:exported="false">
        		  <intent-filter>
        		  	<action android:name="com.resurrection.blowtorch2.lib.window.MainWindow.NORMAL_MODE"/>
        		  	<category android:name="android.intent.category.DEFAULT"/>
        		  </intent-filter>
        </activity>
        
        <service tools:replace="android:process" android:name="com.resurrection.blowtorch2.lib.service.StellarService"
        		 android:process=":stellar" android:exported="false"
        		 android:foregroundServiceType="specialUse">
        		 <property
        		     android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
        		     android:value="Keeps the MUD TCP session alive while the screen is off"/>
        		 <intent-filter>
        		 	<action android:name="com.resurrection.blowtorch2.lib.service.IStellarService.MODE_NORMAL"/>
        		 </intent-filter>
        </service>
        		  

    </application>
    


</manifest> 
